// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken  String?
  refreshTokenExpires DateTime?
}

model AppSettings {
  id                  String   @id @default(uuid())
  shop                String   @unique
  customText          String   @default("Your Name Here")
  customColor         String   @default("#5c6ac4")
  fontSize            Int      @default(16)
  deliveryRadius      Float    @default(10.0)
  hasCustomizedRadius Boolean  @default(false)
  recoveryEnabled     Boolean  @default(false)
  isEnabled           Boolean  @default(true) 
  
  // NEW FIELDS REQUIRED FOR THE DELIVERY API
  storeLat            Float?
  storeLng            Float?
  unitSystem          String   @default("IMPERIAL")
  
  updatedAt           DateTime @updatedAt
}

model ProductView {
  id        Int      @id @default(autoincrement())
  shop      String
  productId String
  createdAt DateTime @default(now())
}

model Conversion {
  id          Int      @id @default(autoincrement())
  shop        String
  productId   String
  amount      Float
  createdAt   DateTime @default(now())
  @@index([shop])
}

model DeliveryCheck {
  id              String   @id @default(cuid())
  shop            String   
  customerAddress String
  distance        Float
  inRadius        Boolean
  timestamp       DateTime @default(now())
  @@index([shop, timestamp])
}

model ConversionEvent {
  id          String   @id @default(cuid())
  shop        String   
  orderId     String   @unique
  orderValue  Float
  source      String   
  createdAt   DateTime @default(now())
  @@index([shop, createdAt])
}

model CartRecovery {
  id              String   @id @default(cuid())
  shop            String   
  cartToken       String   @unique
  customerEmail   String?
  customerAddress String?
  inDeliveryZone  Boolean
  emailSent       Boolean  @default(false)
  recovered       Boolean  @default(false)
  recoveryValue   Float?
  createdAt       DateTime @default(now())
  @@index([shop, emailSent, recovered])
}