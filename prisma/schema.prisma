generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id          String    @id
  shop        String
  state       String
  isOnline    Boolean   @default(false)
  scope       String?
  expires     DateTime?
  accessToken String
  userId      BigInt?
  firstName   String?
  lastName    String?
  email       String?
  accountOwner Boolean  @default(false)
  locale      String?
  collaborator Boolean? @default(false)
  emailVerified Boolean? @default(false)
}

model AppSettings {
  id                   String   @id @default(cuid())
  shop                 String   @unique
  deliveryRadius       Float    @default(6.0)
  unitSystem           String   @default("IMPERIAL")
  hasCustomizedRadius  Boolean  @default(false)
  storeLat             Float?
  storeLng             Float?
  storeAddress         String?
  revenueSuiteEnabled  Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  headerText           String   @default("Local Delivery Available")
  headerColor          String   @default("#008060")
  fontSize             String   @default("16")
  buttonText           String   @default("Check Availability")

  recoveryEnabled      Boolean  @default(false)
  
  @@index([shop])
}

model DeliveryCheck {
  id              String   @id @default(cuid())
  shop            String
  customerAddress String?
  customerLat     Float?
  customerLng     Float?
  distance        Float?
  inRadius        Boolean
  cartToken       String?
  timestamp       DateTime @default(now())
  
  @@index([shop, timestamp])
  @@index([cartToken])
}

model ConversionEvent {
  id          String   @id @default(cuid())
  shop        String
  orderId     String   @unique
  orderValue  Float
  source      String   
  cartToken   String?
  createdAt   DateTime @default(now())
  
  @@index([shop, createdAt])
  @@index([cartToken])
}

model CartRecovery {
  id              String   @id @default(cuid())
  shop            String
  cartToken       String   @unique
  customerEmail   String?
  customerAddress String?
  customerLat     Float?
  customerLng     Float?
  inDeliveryZone  Boolean
  emailSent       Boolean  @default(false)
  emailSentAt     DateTime?
  recovered       Boolean  @default(false)
  recoveredAt     DateTime?
  recoveryValue   Float?
  cartValue       Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([shop, emailSent, recovered])
  @@index([cartToken])
}

model ProductView {
  id          String   @id @default(cuid())
  shop        String
  productId   String
  productTitle String
  viewCount   Int      @default(1)
  lastViewed  DateTime @default(now())
  
  @@unique([shop, productId])
  @@index([shop, lastViewed])
}