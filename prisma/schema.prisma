generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model AppSettings {
  id                   String   @id @default(cuid())
  shop                 String   @unique
  deliveryRadius       Float    @default(6.0)
  unitSystem           String   @default("IMPERIAL")
  hasCustomizedRadius  Boolean  @default(false)
  storeLat             Float?
  storeLng             Float?
  storeAddress         String?
  revenueSuiteEnabled  Boolean  @default(false)
  
  // Personalizer
  headerText           String   @default("Local Delivery Available")
  headerColor          String   @default("#008060")
  fontSize             String   @default("16")
  buttonText           String   @default("Check Availability")
  
  // Cart Recovery (From Claude)
  recoveryEmailEnabled Boolean  @default(false)
  recoveryEmailSubject String   @default("Good news! We deliver to you!")
  recoveryEmailBody    String   @default("You left something behind! Great news — we deliver directly to your area. Come back and complete your order.")
  
  // A/B Testing (From Claude)
  abTestEnabled        Boolean  @default(false)
  abTestMessageA       String   @default("We deliver to your area!")
  abTestMessageB       String   @default("Fast local delivery available!")

  dailyGoal            Float    @default(500)

  hasLeftReview        Boolean   @default(false)
  reviewDismissedAt    DateTime?
  referralCode         String?   @unique
  referralCount        Int       @default(0)

  onboardingDismissed  Boolean  @default(false)
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  uninstalledAt        DateTime?
  
  @@index([shop])
}

model DeliveryCheck {
  id              String   @id @default(cuid())
  shop            String
  customerAddress String?
  customerLat     Float?
  customerLng     Float?
  distance        Float?
  inRadius        Boolean
  cartToken       String?
  timestamp       DateTime @default(now())
  
  @@index([shop, timestamp])
  @@index([cartToken])
}

model ConversionEvent {
  id          String   @id @default(cuid())
  shop        String
  orderId     String   @unique
  orderValue  Float
  source      String
  cartToken   String?
  createdAt   DateTime @default(now())
  
  @@index([shop, createdAt])
  @@index([cartToken])
}

model CartRecovery {
  id              String    @id @default(cuid())
  shop            String
  cartToken       String    @unique
  customerEmail   String?
  customerAddress String?
  customerLat     Float?
  customerLng     Float?
  inDeliveryZone  Boolean
  emailSent       Boolean   @default(false)
  emailSentAt     DateTime?
  recovered       Boolean   @default(false)
  recoveredAt     DateTime?
  recoveryValue   Float?
  cartValue       Float?
  abTestVariant   String?
  
  // --- AGENTIC FIELDS ---
  lineItems       Json?    
  discountCode    String?  
  agentStatus     String   @default("IDLE") 
  generatedEmail  String?  @db.Text
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([shop, emailSent, recovered])
  @@index([cartToken])
}

model ProductView {
  id           String   @id @default(cuid())
  shop         String
  productId    String
  productTitle String
  viewCount    Int      @default(1)
  lastViewed   DateTime @default(now())
  
  @@unique([shop, productId])
  @@index([shop, lastViewed])
}

// --- OUR ENTERPRISE ENGINE ---
model RevenueLeak {
  id              String   @id @default(cuid())
  shop            String
  type            String   
  severity        String   
  title           String   
  potentialValue  Float    
  status          String   @default("DETECTED") 
  metadata        Json?    
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shop, status])
  @@index([shop, type])
}

model GeoCache {
  id        String   @id @default(cuid())
  address   String   @unique
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
  
  @@index([address])
}