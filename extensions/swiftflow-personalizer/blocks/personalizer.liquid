<div id="sf-banner" style="display: none; padding: 10px; margin-bottom: 10px; border-radius: 4px; text-align: center;">
  <span id="sf-banner-text" style="font-weight: bold; color: #ffffff;"></span>
</div>

<div class="swiftflow-container" style="padding: 20px; border: 1px solid #e1e3e5; border-radius: 8px; background: #fafbfb;">
  <h4 id="sf-block-heading" style="margin-bottom: 10px; font-weight: 600;">{{ block.settings.heading }}</h4>
  <input type="text" id="sf-custom-text" placeholder="Type here..." style="width: 100%; padding: 10px; border: 1px solid #c9cccf; border-radius: 4px;">
</div>

<script>
  // 1. Fetch settings from App Proxy
  async function loadSwiftFlowSettings() {
    try {
      const response = await fetch('/apps/swiftflow-revenue?product_id={{ product.id }}');
      const data = await response.json();

      if (data && data.headerText) {
        const banner = document.getElementById('sf-banner');
        const text = document.getElementById('sf-banner-text');
        
        if (banner && text) {
          banner.style.display = 'block';
          banner.style.backgroundColor = data.headerColor || '#008060';
          text.innerText = data.headerText;
        }
      }
    } catch (e) {
      console.error("SwiftFlow Proxy Error:", e);
    }
  }

  // 2. The Bulletproof Cart Sync Logic
  function attachToCart() {
    const customInput = document.getElementById('sf-custom-text');
    // Find the standard Shopify Add to Cart form on the page
    const productForm = document.querySelector('form[action^="/cart/add"]');

    if (productForm && customInput) {
      // Create a hidden input that lives INSIDE the actual theme form
      const hiddenInput = document.createElement('input');
      hiddenInput.type = 'hidden';
      hiddenInput.name = 'properties[Personalization text]';
      productForm.appendChild(hiddenInput);

      // Whenever the user types in your box, copy it to the hidden input
      customInput.addEventListener('input', (e) => {
        hiddenInput.value = e.target.value;
      });
    } else {
      console.warn("SwiftFlow: Could not find the main product form.");
    }
  }

  // 3. Initialize Everything
  function initSwiftFlow() {
    loadSwiftFlowSettings();
    attachToCart();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSwiftFlow);
  } else {
    initSwiftFlow();
  }
</script>

{% schema %}
{
  "name": "SwiftFlow Personalizer",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Personalize Your Order" }
  ]
}
{% endschema %}