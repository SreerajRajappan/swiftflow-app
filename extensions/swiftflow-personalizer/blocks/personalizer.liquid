<div id="sf-banner" style="display: none; padding: 10px; margin-bottom: 10px; border-radius: 4px; text-align: center;">
  <span id="sf-banner-text" style="font-weight: bold; color: #ffffff;"></span>
</div>

<div id="sf-widget-container" class="swiftflow-container" style="padding: 20px; border: 1px solid #e1e3e5; border-radius: 8px; background: #fafbfb;">
  <h4 id="sf-block-heading" style="margin-bottom: 10px; font-weight: 600;">{{ block.settings.heading }}</h4>
  
  <input type="text" 
         id="sf-custom-text" 
         placeholder="Add a gift message, slicing preference, or specific delivery instructions for our driver..." 
         style="width: 100%; padding: 10px; border: 1px solid #c9cccf; border-radius: 4px;">
</div>

<script>
  (function() {
    // A/B Test Holdout Group Logic
    // 10% of traffic sees NOTHING, but we still track them to prove incrementality.
    const isControlGroup = Math.random() < 0.10; 

    if (isControlGroup) {
      // Hide the main widget container immediately
      const widgetContainer = document.getElementById('sf-widget-container');
      if (widgetContainer) widgetContainer.style.display = 'none';
      // The banner is hidden by default, so it remains hidden.
    }

    async function loadSwiftFlow() {
      // Don't waste proxy fetch resources on the control group
      if (isControlGroup) return; 

      try {
        const response = await fetch(`/apps/swiftflow-revenue/proxy?product_id={{ product.id }}`);
        if (!response.ok) return;
        
        const data = await response.json();
        
        if (data.headerText) {
          const banner = document.getElementById('sf-banner');
          const text = document.getElementById('sf-banner-text');
          
          banner.style.display = 'block';
          banner.style.backgroundColor = data.headerColor || '#008060';
          text.innerText = data.headerText;
        }
      } catch (e) {
        console.error("SwiftFlow Script Error:", e);
      }
    }

    // Inject hidden inputs directly into the theme's forms
    function attachToCartForm() {
      const visibleInput = document.getElementById('sf-custom-text');
      const productForms = document.querySelectorAll('form[action*="/cart/add"]');
      
      productForms.forEach(form => {
        // 1. Personalization Text Field (Only if the widget is visible)
        if (visibleInput && !form.querySelector('.sf-hidden-personalization')) {
          const hiddenInput = document.createElement('input');
          hiddenInput.type = 'hidden';
          hiddenInput.name = 'properties[Personalization]';
          hiddenInput.className = 'sf-hidden-personalization';
          form.appendChild(hiddenInput);
        }

        // 🚀 2. Inject the hidden tracking attribution property!
        if (!form.querySelector('.sf-tracking-source')) {
          const trackingInput = document.createElement('input');
          trackingInput.type = 'hidden';
          trackingInput.name = 'properties[_SwiftFlow_Source]';
          // Tag the cart with their exact A/B test cohort
          trackingInput.value = isControlGroup ? 'control_group' : 'delivery_badge'; 
          trackingInput.className = 'sf-tracking-source';
          form.appendChild(trackingInput);
        }
      });

      // Sync the visible text to the hidden inputs
      if (visibleInput) {
        visibleInput.addEventListener('input', function(e) {
          const hiddenInputs = document.querySelectorAll('.sf-hidden-personalization');
          hiddenInputs.forEach(hidden => {
            hidden.value = e.target.value;
          });
        });
      }
    }

    function init() {
      loadSwiftFlow();
      // A tiny 500ms delay to let the theme finish rendering its forms
      setTimeout(attachToCartForm, 500);
    }

    // Ensures the script runs correctly inside the Shopify Theme Editor
    if (window.Shopify && window.Shopify.designMode) {
      init();
    } else {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init(); // Catch case where script loads after DOMContentLoaded
      }
    }
  })();
</script>

{% schema %}
{
  "name": "SwiftFlow Personalizer",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Order Notes & Personalization" }
  ]
}
{% endschema %}