<div id="sf-banner" style="display: none; padding: 10px; margin-bottom: 10px; border-radius: 4px; text-align: center;">
  <span id="sf-banner-text" style="font-weight: bold; color: #ffffff;"></span>
</div>

<div class="swiftflow-container" style="padding: 20px; border: 1px solid #e1e3e5; border-radius: 8px; background: #fafbfb;">
  <h4 id="sf-block-heading" style="margin-bottom: 10px; font-weight: 600;">{{ block.settings.heading }}</h4>
  
  <input type="text" 
         id="sf-custom-text" 
         placeholder="Type here..." 
         style="width: 100%; padding: 10px; border: 1px solid #c9cccf; border-radius: 4px;">
</div>

<script>
  (function() {
    async function loadSwiftFlow() {
      try {
        // Unified Proxy URL
        const response = await fetch(`/apps/swiftflow/api/proxy?product_id={{ product.id }}`);
        if (!response.ok) return;
        
        const data = await response.json();

        if (data.headerText) {
          const banner = document.getElementById('sf-banner');
          const text = document.getElementById('sf-banner-text');
          
          banner.style.display = 'block';
          banner.style.backgroundColor = data.headerColor || '#008060';
          text.innerText = data.headerText;
        }
      } catch (e) {
        console.error("SwiftFlow Script Error:", e);
      }
    }

    // Inject hidden inputs directly into the theme's forms
    function attachToCartForm() {
      const visibleInput = document.getElementById('sf-custom-text');
      if (!visibleInput) return;

      // Find all "Add to Cart" forms on the page
      const productForms = document.querySelectorAll('form[action*="/cart/add"]');

      productForms.forEach(form => {
        // Create a hidden field inside the form ONLY if it doesn't already exist
        if (!form.querySelector('.sf-hidden-personalization')) {
          const hiddenInput = document.createElement('input');
          hiddenInput.type = 'hidden';
          hiddenInput.name = 'properties[Personalization]';
          hiddenInput.className = 'sf-hidden-personalization';
          form.appendChild(hiddenInput);
        }
      });

      // Every time the customer types, copy the text to the hidden fields
      visibleInput.addEventListener('input', function(e) {
        const hiddenInputs = document.querySelectorAll('.sf-hidden-personalization');
        hiddenInputs.forEach(hidden => {
          hidden.value = e.target.value;
        });
      });
    }

    function init() {
      loadSwiftFlow();
      // A tiny 500ms delay to let the theme finish rendering its forms
      setTimeout(attachToCartForm, 500); 
    }

    // Ensures the script runs correctly inside the Shopify Theme Editor
    if (window.Shopify && window.Shopify.designMode) {
      init();
    } else {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init(); // Catch case where script loads after DOMContentLoaded
      }
    }
  })();
</script>

{% schema %}
{
  "name": "SwiftFlow Personalizer",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Personalize Your Order" }
  ]
}
{% endschema %}