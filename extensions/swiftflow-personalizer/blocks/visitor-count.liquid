<div id="sf-visitor-count" style="padding: 10px; border-radius: 5px; margin: 10px 0;">
  <span id="sf-count-text" style="color: {{ block.settings.text_color }}; font-size: {{ block.settings.font_size }}px; font-weight: bold;">
    🔥 Checking live visitors...
  </span>
</div>

<script>
  document.addEventListener('DOMContentLoaded', async function() {
    {% if request.page_type == 'product' %}
      const productId = "{{ product.id }}";
      const productTitle = "{{ product.title | escape }}";
      const shopDomain = Shopify.shop;
      
      try {
        const hasViewed = sessionStorage.getItem(`viewed_${productId}`);
        
        // Unified Proxy URL matching the TOML subpath
        const proxyUrl = `/apps/swiftflow-revenue/track-view`;
        
        // Single POST request that tracks the view AND returns the current count
        const response = await fetch(proxyUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            productId: productId,
            productTitle: productTitle,
            shopDomain: shopDomain,
            isNewView: !hasViewed // Tells backend whether to increment the view count
          })
        });

        if (response.ok) {
          sessionStorage.setItem(`viewed_${productId}`, 'true');
          const data = await response.json();
          
          // Add a small 'boost' for social proof
          const displayCount = (data.viewCount || 0) + Math.floor(Math.random() * 5) + 1;
          const messageText = "{{ block.settings.message }}";
          
          document.getElementById('sf-count-text').innerText = `🔥 ${displayCount} ${messageText}`;
        }
      } catch (e) {
        console.error("SwiftFlow Visitor Error:", e);
        // Fallback if proxy fails so the UI doesn't look broken
        document.getElementById('sf-count-text').innerText = `🔥 Someone is looking at this right now!`;
      }
    {% endif %}
  });
</script>

{% schema %}
{
  "name": "SF: Live Visitor Count",
  "target": "section",
  "settings": [
    { "type": "text", "id": "message", "label": "Widget Text", "default": "people are looking at this right now!" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ff4500" },
    { "type": "range", "id": "font_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Font Size", "default": 14 }
  ]
}
{% endschema %}